includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
    level: 5
    ignoreErrors:
        # Booking date fields are cast to Carbon via Eloquent casts, but PHPStan
        # sees them as string from $fillable. These format() calls are safe.
        -
            message: '#Cannot call method format\(\) on string#'
            path: app/Modules/Booking/Services/BookingService.php
